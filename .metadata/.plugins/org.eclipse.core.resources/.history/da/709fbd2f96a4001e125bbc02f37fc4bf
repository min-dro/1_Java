	public void practice4() {
		int r = 4;
		int c = 4;
		int[][] arr = new int[r][c];
		for(int i=0; i<r; i++) {
			for(int j=0; j<c; j++) {
				if (i < 3 && j < 3) {
					arr[i][j] = (int)(Math.random() * 10 + 1);
				} else if (i == 3) {
					arr[3][j] = arr[0][j] + arr[1][j] + arr[2][j] + arr[3][j];
				} else if (j == 3) {
					arr[i][3] = arr[i][0] + arr[i][1] + arr[i][2] + arr[i][3];
				}
				System.out.printf("%2d ",arr[i][j]);
			}
			System.out.println();
		}
	}
	public void practice5() {
