		printItem(arr);
	}
	
	// printItem 메소드 : 중복 제거하기 위해 정의. 리스트 내 아이템 출력
	public static <E> void printItem(List<E> list) {	// 제네릭 메소드 정의
		
		for(int i=0; i<list.size(); i++) {
			System.out.println(i +"번쨰: " + list.get(i));
